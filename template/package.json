{
  "name": "my-pyro-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "biome check --write",
    "lint:ci": "biome ci",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "turbo build --filter=./packages/config --output-logs=errors-only && pnpm -F db generate",
    "db:migrate": "turbo build --filter=./packages/config --output-logs=errors-only && pnpm -F db migrate",
    "db:push": "turbo build --filter=./packages/config --output-logs=errors-only && pnpm -F db push",
    "db:studio": "turbo build --filter=./packages/config --output-logs=errors-only && pnpm -F db studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "turbo": "^2.11.10"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  }
}

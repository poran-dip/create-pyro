# Postgres (docker compose)
POSTGRES_USER=app
POSTGRES_PASSWORD=password
POSTGRES_DB=app

# Database (compose.dev.yml publishes Postgres on 15432)
DATABASE_URL=postgresql://app:password@localhost:15432/app

# Auth
BETTER_AUTH_URL=http://localhost:3002
BETTER_AUTH_SECRET=

# API
NODE_ENV=development
API_PORT=3002
CORS_ORIGIN=http://localhost:3000

# Web
PUBLIC_API_URL=http://localhost:3002
INTERNAL_API_URL=http://localhost:3002

# Prod only (compose.yml): the origin nginx is served on
PUBLIC_ORIGIN=http://localhost

{
  "name": "@repo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv-run -- tsx watch --include '../../packages/*/dist/**' src/index.ts",
    "build": "tsdown",
    "start": "dotenv-run -- node dist/index.mjs",
    "typecheck": "tsc",
    "test": "dotenv-run -- vitest run",
    "test:watch": "dotenv-run -- vitest"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@hono/node-server": "catalog:",
    "@paralleldrive/cuid2": "catalog:",
    "@repo/config": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/shared": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@dotenv-run/cli": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "pg": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts"
}
